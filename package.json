{
  "name": "pi-progressive-research",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-driven conversational research for CSD358 T2",
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:ir": "tsx test/core-ir.test.ts",
    "test:engine": "tsx test/engine-retrieval.test.ts && tsx test/engine-coverage.test.ts",
    "test:sdk": "tsx test/sdk-load.test.ts && tsx test/pi-model-session.test.ts",
    "test:context": "tsx test/pi-model-context.test.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "demo": "tsx scripts/demo.ts",
    "test:evaluate": "tsx test/evaluate.test.ts",
    "test": "npm run test:ir && npm run test:engine && npm run test:sdk && npm run test:context && npm run test:evaluate"
  },
  "keywords": [
    "pi-package",
    "information-retrieval"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "pi": {
    "extensions": ["./src/extension.ts"]
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "ipaddr.js": "2.5.0",
    "linkedom": "0.16.11",
    "robots-parser": "3.0.1",
    "unpdf": "1.6.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/node": "24.19.1",
    "tsx": "4.23.15",
    "typebox": "1.3.36",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "typebox": "1.3.36"
  }
}
